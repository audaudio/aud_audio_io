{
  "name": "aud_audio_io",
  "summary": "Audio device IO of the Audanika Audio Engine: session, devices, hot-plug, output/input/duplex streams calling an AudRenderFunction with AudStreamTime; recovery from disconnects, route/rate changes, interruptions; Oboe on Android, miniaudio + AVAudioSession on iOS, miniaudio on the Core Audio HAL on macOS and on WASAPI shared mode with IAudioClient3 periods on Windows (S3b, io-004, io-005), null device on Linux until its part of S3b.",
  "domain": [
    "Audio device IO of the Audanika Audio Engine",
    "Stream timing (time-001), lifecycle per platform (lifecycle-001)",
    "Null device with injected faults; latency probe",
    "The audio thread on the fast cores of Android (io-003): a performance hint session from Android 12, below it an affinity to the cores above the slowest clock, reported in the counters as an AudIoPlacement"
  ],
  "interfaces": {
    "uses": {
      "aud_audio_core": "aud_abi.h (AudRenderFunction, AudRenderRequest, AudStreamTime, AudAudioBus), aud_clock.h, aud_spsc_queue.hpp; Dart AudStreamTime, AudTimeSource",
      "aud_audio_graph": "dev: end-to-end test, aud_graph_render through a stream",
      "jni, jni_flutter": "Android: AudioManager devices, audio focus, RECORD_AUDIO"
    },
    "usedBy": {
      "aud_audio": "umbrella wires AudIoStream to AudGraph (S4)",
      "aud_audio_web": "consumes this package"
    }
  }
}
